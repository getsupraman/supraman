// Resource 1 is the icon gpui's Windows platform loads for its window class (gpui_windows load_icon)
// and the one Explorer shows for supraman.exe; 2 and 3 are the tray's by taskbar theme (tray.rs).
1 ICON "supraman.ico"
2 ICON "tray-on-dark.ico"
3 ICON "tray-on-light.ico"
// The application manifest (RT_MANIFEST 24), language-neutral so that it, not gpui's, applies
// (foreman.manifest): no console window of its own (main.rs release_own_console).
LANGUAGE 0, 0
1 24 "foreman.manifest"
